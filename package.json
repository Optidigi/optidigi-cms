{
  "name": "optidigi-cms",
  "version": "1.0.0",
  "description": "Optidigi CMS: one Payload CMS for several independently deployed websites",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/mcp": "2.0.102",
    "@ai-sdk/mistral": "4.0.89",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/react": "4.0.183",
    "@base-ui/react": "1.9.0",
    "@lexical/list": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@payloadcms/db-postgres": "4.0.0-beta.11",
    "@payloadcms/email-nodemailer": "4.0.0-beta.11",
    "@payloadcms/next": "4.0.0-beta.11",
    "@payloadcms/plugin-mcp": "4.0.0-beta.11",
    "@payloadcms/plugin-multi-tenant": "4.0.0-beta.11",
    "@payloadcms/richtext-lexical": "4.0.0-beta.11",
    "@payloadcms/transformer-sharp": "4.0.0-beta.11",
    "@payloadcms/translations": "4.0.0-beta.11",
    "@payloadcms/ui": "4.0.0-beta.11",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/postcss": "4.3.5",
    "ai": "7.0.179",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "cross-env": "10.1.0",
    "dotenv": "18.0.10",
    "geist": "1.9.2",
    "graphql": "16.15.0",
    "lexical": "0.53.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "payload": "4.0.0-beta.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.1",
    "recharts": "3.11.0",
    "sonner": "2.0.8",
    "streamdown": "2.8.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "oxfmt": "0.79.0",
    "shadcn": "4.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "private": true
}
