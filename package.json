{
  "name": "optidigi-cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/mcp": "2.0.101",
    "@ai-sdk/openai": "4.0.121",
    "@ai-sdk/openai-compatible": "3.0.93",
    "@ai-sdk/react": "4.0.181",
    "@base-ui/react": "^1.9.0",
    "@lexical/list": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@payloadcms/db-postgres": "4.0.0-beta.10",
    "@payloadcms/email-nodemailer": "4.0.0-beta.10",
    "@payloadcms/next": "4.0.0-beta.10",
    "@payloadcms/plugin-mcp": "4.0.0-beta.10",
    "@payloadcms/plugin-multi-tenant": "4.0.0-beta.10",
    "@payloadcms/richtext-lexical": "4.0.0-beta.10",
    "@payloadcms/transformer-sharp": "4.0.0-beta.10",
    "@payloadcms/translations": "4.0.0-beta.10",
    "@payloadcms/ui": "4.0.0-beta.10",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "4.3.5",
    "ai": "7.0.177",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "geist": "1.9.2",
    "graphql": "^16.8.1",
    "lexical": "0.53.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "payload": "4.0.0-beta.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.0.0",
    "oxfmt": "^0.73.0",
    "shadcn": "4.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
